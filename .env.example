# ============================================
# VARIABLES DE ENTORNO - Plantilla SaaS
# ============================================
# Copia este archivo a .env.local:
#   cp .env.example .env.local
# Luego rellena cada variable con tus valores.
# ============================================

# --- SUPABASE ---
# Dashboard: https://supabase.com/dashboard > Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- STRIPE ---
# Dashboard: https://dashboard.stripe.com/apikeys
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=

# Webhook secret (para verificar eventos de Stripe)
# En desarrollo: ejecuta 'stripe listen --forward-to localhost:3000/api/webhook/stripe'
# En produccion: https://dashboard.stripe.com/webhooks > tu endpoint > Signing secret
STRIPE_WEBHOOK_SECRET=

# --- RESEND (Email) ---
# Dashboard: https://resend.com/api-keys
RESEND_API_KEY=

# --- OPCIONAL ---
# URL del sitio (usado para sitemap y meta tags)
# SITE_URL=https://tudominio.com

# ============================================
# EXPERIMENTO VEGA (vega_beachhead_v1)
# ============================================
# Contrato de variables congelado en Sprint 0, activado progresivamente
# sprint a sprint. No rellenar con secretos reales hasta que el sprint
# correspondiente conecte esa integracion de verdad.

EXPERIMENT_ID=vega_beachhead_v1
APP_URL=http://localhost:3000

# --- PERSISTENCIA EXPERIMENTAL (Sprint 1) ---
# "memory": repositorio en memoria, solo para desarrollo/tests locales
#   mientras no hay un proyecto Supabase real conectado.
# "supabase": Postgres real via supabase-js + SUPABASE_SERVICE_ROLE_KEY,
#   requiere haber aplicado supabase/migrations/.
EXPERIMENT_DB_DRIVER=memory

# --- CREDENCIAL DE SESION (guard de pertenencia de flowAttemptId) ---
# Secreto usado para firmar (HMAC-SHA256) la cookie httpOnly vega_session,
# unica credencial que las rutas de negocio aceptan para autorizar
# operaciones sobre un flowAttemptId. Nunca debe llevar el prefijo
# NEXT_PUBLIC_ (no se envia nunca al cliente). Genera un valor aleatorio
# largo, p. ej.: openssl rand -base64 32
EXPERIMENT_SESSION_SECRET=

# --- POSTHOG (EU/Frankfurt) --- (Sprint 1)
# Sin key, initPostHog() no hace nada (no-op seguro): no hay proyecto
# PostHog real conectado en desarrollo todavia.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# --- MOTOR VEGA --- (Sprint 3A: contrato definitivo POST /evidence/natal)
# Nombres actualizados respecto al placeholder de Sprint 0
# (VEGA_API_URL/VEGA_API_TOKEN): el encargo de Sprint 3A fijo estos nombres
# exactos para el contrato real. SONDA19_INTERNAL_EVIDENCE_TOKEN viaja como
# header X-Internal-Evidence-Token, nunca al navegador.
# "mock": doble de pruebas en memoria, sin llamar a Railway (por defecto,
#   desarrollo/tests/E2E normales).
# "real": HTTP real contra VEGA_API_BASE_URL, requiere el token real.
VEGA_CLIENT_DRIVER=mock
VEGA_API_BASE_URL=
SONDA19_INTERNAL_EVIDENCE_TOKEN=
VEGA_API_TIMEOUT_MS=15000

# --- OPENAI (Responses API + Structured Outputs) --- (Sprint 3A)
# "mock": doble de pruebas deterministico, sin llamar a OpenAI (por
#   defecto, desarrollo/tests/E2E normales).
# "real": llamada real, requiere OPENAI_API_KEY.
OPENAI_PREVIEW_CLIENT_DRIVER=mock
OPENAI_API_KEY=
OPENAI_PREVIEW_MODEL=gpt-5.6-luna
OPENAI_PREVIEW_TIMEOUT_MS=15000

# --- N8N (solo waitlist -> email de confirmacion) --- (Sprint 4)
N8N_WEBHOOK_SECRET=
