# ============================================
# VARIABLES DE ENTORNO - Plantilla SaaS
# ============================================
# Copia este archivo a .env.local:
#   cp .env.example .env.local
# Luego rellena cada variable con tus valores.
# ============================================

# --- SUPABASE ---
# Dashboard: https://supabase.com/dashboard > Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- STRIPE ---
# Dashboard: https://dashboard.stripe.com/apikeys
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=

# Webhook secret (para verificar eventos de Stripe)
# En desarrollo: ejecuta 'stripe listen --forward-to localhost:3000/api/webhook/stripe'
# En produccion: https://dashboard.stripe.com/webhooks > tu endpoint > Signing secret
STRIPE_WEBHOOK_SECRET=

# --- RESEND (Email) ---
# Dashboard: https://resend.com/api-keys
RESEND_API_KEY=

# --- OPCIONAL ---
# URL del sitio (usado para sitemap y meta tags)
# SITE_URL=https://tudominio.com
